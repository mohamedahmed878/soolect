# ---- Backend (Vercel Environment Variables / local .env) ----
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/soolect?retryWrites=true&w=majority
# At least 16 random characters, e.g.  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# The single admin account. It signs in on the admin site (the admin/ folder).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Comma-separated origins allowed to call the API from another domain. REQUIRED for the separate admin site
# (e.g. https://soolect-admin.vercel.app). Not needed for the store itself (same domain).
CLIENT_ORIGIN=

# Optional: real-time order updates. Leave empty to disable.
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=eu

PORT=4000

# ---- Frontend (build-time, read by Vite) ----
# "/" = use the API on the same domain.  Leave empty = demo mode with no backend.
VITE_API_URL=/
VITE_PUSHER_KEY=
VITE_PUSHER_CLUSTER=eu
